# ─── Supabase ───────────────────────────────────────────
# From `supabase start` locally, or Project Settings → API in the dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-only — never prefix with NEXT_PUBLIC_,
# never import into anything reachable from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Direct connection, used ONLY by the CLI for migrations and type generation.
# Application code never opens a Postgres connection.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Trigger.dev ────────────────────────────────────────
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxxx
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxx

# ─── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
